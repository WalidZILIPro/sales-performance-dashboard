{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5434;Database=sales_dashboard;Username=postgres;Password=postgres"
  },
  "Database": {
    "Migrate": true,
    "Seed": true
  },
  "RateLimiting": {
    "TokenLimit": 60,
    "TokensPerSecond": 10
  },
